# GTM Signal Intelligence — API Configuration
# ============================================

# PRIMARY: LLM inference (Groq recommended for speed, deterministic tests)
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# FALLBACK: LLM inference (Anthropic, used if Groq key not set)
# Required for LLM agents (Days 1-13): extraction, reranking, answers, research, scoring, personas, writing, critique
# Get key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# RAG: Embeddings (optional, upgrade from offline TF-IDF to semantic search)
# Get key at: https://www.voyageai.com
# VOYAGE_API_KEY=pa-...

# Research Agent: Web search (optional, for company enrichment)
# Get key at: https://tavily.com
# TAVILY_API_KEY=tvly-...

# Observability (optional): LLM traces, latency, cost tracking
# Get keys at: https://langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# Database (optional): SQLite by default (./gtm_signal.db), Postgres for production
# DATABASE_URL=postgresql://user:password@localhost/gtm_signal
